# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.venv-*/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.import_linter_cache/

# Node (generated TS tooling, teammates' apps)
node_modules/

# Runtime state, generated data, large artifacts (never committed)
var/
ml/artifacts/

# Secrets
.env
.env.*
!.env.example

# Obsidian: per-user UI state stays local; shared vault settings are committed
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json
.obsidian/cache/
.trash/

# OS / editors / local tool settings
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
.claude/settings.local.json

# Project documents (PRD, decisions, designs, reports) are kept local, never committed.
docs/

# Logs, caches and build leftovers (the apps)
*.log
.vite/
*.tsbuildinfo
coverage/

# Blender's automatic backups (house_typeB.blend1, …)
*.blend1
*.blend2

# browser test artefacts (Playwright MCP)
.playwright-mcp/
