# Copy to .env (git-ignored) and fill in. Never commit a real key.

# Core API: AI explanations and "Ask Penjaga" chat (step 6). Leave the key empty to run templates only.
# Get a key at https://openrouter.ai/keys, and in the OpenRouter dashboard set a credit limit on it
# and keep prompt logging off.
OPENROUTER_API_KEY=
# Models are config, not code. Primary, then fallbacks tried in order by OpenRouter.
PENJAGA_MODEL=deepseek/deepseek-v4.1-flash
PENJAGA_MODEL_FALLBACKS=anthropic/claude-haiku-5.5
PENJAGA_LLM_TIMEOUT_S=45
# DeepSeek V4.1 Flash reasons at high effort by default; low is enough for Penjaga's tasks.
PENJAGA_REASONING_EFFORT=low

# Penjaga's voice (Google Cloud Text-to-Speech). Leave the key empty and the app speaks with the browser's own voice.
# In Google Cloud: enable the Cloud Text-to-Speech API, create an API key (APIs & Services > Credentials) and restrict
# it to that API. The key stays here, on the backend; the browser never sees it.
GOOGLE_TTS_API_KEY=
# A Chirp 3: HD voice (https://docs.cloud.google.com/text-to-speech/docs/chirp3-hd): <locale>-Chirp3-HD-<name>
PENJAGA_TTS_VOICE=en-GB-Chirp3-HD-Aoede
PENJAGA_TTS_RATE=1.0

# ---- Homeowner app (copy these to .env.local, git-ignored). Never commit a real token.

# Which backend the app talks to:
#   standin  the in-browser stand-in (default; no backend needed)
#   api      the real Core API (run the backend first: `uv run python scripts/dev_stack.py`)
VITE_BACKEND=standin

# Dev proxy settings (read by vite.config.js on the dev server only; never sent to the browser).
PENJAGA_API_URL=http://127.0.0.1:8705
# The homeowner token. Leave empty to read it from the Core API's dev token file below.
PENJAGA_API_TOKEN=
PENJAGA_API_TOKENS_FILE=var/api-tokens.json
